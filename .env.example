# ── Required ──────────────────────────────────────────────────────────────────
# Neon free-tier PostgreSQL connection strings.
# Get from: https://console.neon.tech → your project → Connection Details.

# Async driver (FastAPI Lambda)
DATABASE_URL=postgresql+asyncpg://scanner:password@ep-xxx-yyy.ap-southeast-1.aws.neon.tech/scandb?sslmode=require

# Sync driver (Scanner Lambda + Alembic migrations)
DATABASE_URL_SYNC=postgresql://scanner:password@ep-xxx-yyy.ap-southeast-1.aws.neon.tech/scandb?sslmode=require

# ── AWS Cognito ───────────────────────────────────────────────────────────────
# Created automatically by SAM deploy (infra/template.yaml).
# Fill in after first `sam deploy`.

COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS Lambda ────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
SCANNER_LAMBDA_NAME=cci-sma-scanner

# ── Scanner admin user ────────────────────────────────────────────────────────
# The Cognito sub of the user who "owns" the pre-loaded watchlist CSVs.
# Set to your own Cognito sub after first login.
ADMIN_COGNITO_SUB=your-cognito-sub-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://jandginvestment.github.io,http://localhost:4200

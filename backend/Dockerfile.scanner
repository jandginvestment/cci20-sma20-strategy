# ── AWS Lambda Scanner — Lightweight Container Image ───────────────────────────
FROM public.ecr.aws/lambda/python:3.11 AS builder

COPY scanner_requirements.txt .
RUN pip install --no-cache-dir --target /install -r scanner_requirements.txt

# ── Final image — only runtime files ──────────────────────────────────────────
FROM public.ecr.aws/lambda/python:3.11

# Copy installed packages
COPY --from=builder /install ${LAMBDA_TASK_ROOT}

# Copy only scanner source (exclude venv, node_modules, __pycache__, watchlist CSVs not needed at image time)
COPY scanner.py scanner_lambda.py ${LAMBDA_TASK_ROOT}/
COPY db/ ${LAMBDA_TASK_ROOT}/db/
COPY watchlists/ ${LAMBDA_TASK_ROOT}/watchlists/

CMD ["scanner_lambda.handler"]
